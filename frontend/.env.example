# ローカル開発: 未設定でよい（相対 /api → Vite が 127.0.0.1:8000 にプロキシ）
# 本番（Vercel 等）: 必ず絶対 URL（例: https://api.example.com/api）
# NUXT_PUBLIC_API_BASE_URL=https://your-api.example.com/api

# artisan serve がポート競合で 8001 等になったときだけ指定（Nuxt 再起動が必要）
# NUXT_DEV_API_PROXY_TARGET=http://127.0.0.1:8001

# Laravel Reverb / Echo（リアルタイム同期）
# backend の REVERB_APP_KEY と一致させる。
# 本番 ECS: ブラウザから見た API ホスト（nginx が /app を Reverb へプロキシ）
# NUXT_PUBLIC_REVERB_HOST=api.example.com
# NUXT_PUBLIC_REVERB_PORT=443
# NUXT_PUBLIC_REVERB_SCHEME=https
NUXT_PUBLIC_REVERB_KEY=your-reverb-app-key
NUXT_PUBLIC_REVERB_HOST=127.0.0.1
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http
