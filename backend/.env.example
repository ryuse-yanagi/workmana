APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=task_manager
DB_USERNAME=postgres
DB_PASSWORD=

# DB_URL=pgsql://postgres@127.0.0.1:5432/task_manager
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cognito のトークンを含むサーバー側セッションの保存データを暗号化するため必須
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# ローカルHTTPでは false。本番HTTPSでは AppServiceProvider が true を必須検証する。
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
# BROADCAST_FAIL_SILENTLY=true

REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ローカルは log（ログ出力のみ）。本番では Amazon SES 必須
# （AppServiceProvider が MAIL_MAILER=ses|ses-v2 と MAIL_FROM_ADDRESS を検証する）。
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 本番 SES 例:
# MAIL_MAILER=ses
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_FROM_NAME="${APP_NAME}"
# AWS_DEFAULT_REGION=ap-northeast-1
# IAM タスクロール利用時はキー不要。キー方式なら下記を設定。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- 業務管理アプリ（設計書）---
# フロント（CORS）。カンマ区切りで複数可
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Amazon Cognito JWT（本番・ステージング）
# JWKS: https://cognito-idp.{region}.amazonaws.com/{userPoolId}/.well-known/jwks.json
# ISSUER: https://cognito-idp.{region}.amazonaws.com/{userPoolId}
# AUDIENCE: 必須。ID Token の aud と照合するアプリクライアント ID
COGNITO_JWKS_URL=
COGNITO_ISSUER=
COGNITO_AUDIENCE=

# Hosted UI / 認可コードフロー（PKCE）。トークン交換はバックエンドのみで行う。
# DOMAIN 例: https://example.auth.ap-northeast-1.amazoncognito.com
# REDIRECT_URI はブラウザから見た URL。Cognito アプリクライアントの
# 「許可されているコールバック URL」にも同じ値を登録すること。
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
# パブリッククライアント（シークレットなし）の場合は空のまま
COGNITO_CLIENT_SECRET=
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_REDIRECT_URI=http://localhost:3000/login
COGNITO_SCOPES="openid email profile"
COGNITO_FRONTEND_URL=http://localhost:3000
COGNITO_DEFAULT_REDIRECT_PATH=/post-login

# 招待登録時の Cognito ユーザー作成（AdminCreateUser）。未設定時は Client SignUp API を使用。
# COGNITO_REGION=ap-northeast-1
# COGNITO_USER_POOL_ID=

# ローカルのみ true。本番では AppServiceProvider が false を必須検証する。
# バイパスを使う場合 COGNITO_BYPASS_USER_ID は必須。
# ブラウザは Cookie 認証のみで Authorization ヘッダを送らないため、未設定だとログインできない。
# curl 等から直接叩く場合は Bearer にユーザー ID（数字）を載せる方法も使える。
COGNITO_BYPASS=false
COGNITO_BYPASS_USER_ID=

# 組織招待リンクの有効期限（日）
ORGANIZATION_INVITE_EXPIRES_DAYS=7

# 非同期キュー（SQS に切り替え時は QUEUE_CONNECTION=sqs と AWS 設定）
# SQS_PREFIX= https://sqs.{region}.amazonaws.com/{account_id}
# SQS_QUEUE= キュー名
